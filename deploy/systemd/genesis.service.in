# genesis agent — system service (Tailscale-like background daemon)
#
# Generated from genesis.service.in (PREFIX=@PREFIX@).
# Preferred install: make check-deps && make build && sudo make install ENABLE=1
#
# Operator UX:
#   genesis-ctl up | down | restart | apply | service-status
#   apply = systemctl reload → SIGHUP → hot-reload YAML rules
#
# See docs/service.md

[Unit]
Description=genesis DNS stub and policy path pins
Documentation=file://@PREFIX@/share/doc/genesis/service.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=GENESIS_CONFIG=/etc/genesis/config.yaml
ExecStart=@PREFIX@/bin/genesis-agent -config /etc/genesis/config.yaml -pidfile /run/genesis/agent.pid
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
RuntimeDirectory=genesis

ProtectSystem=strict
ReadWritePaths=/run/genesis /etc/genesis
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
